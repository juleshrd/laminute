{
  "name": "laminute",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run build:web && npm run build:rust",
    "build:web": "tsc && vite build",
    "build:rust": "cargo build --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "lint": "npm run lint:web && npm run lint:rust",
    "lint:web": "eslint . && tsc --noEmit && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "npm run format:web && npm run format:rust",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "format:web": "prettier --write .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "build:bundle": "tauri build",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "audit:npm": "npm audit --audit-level=high",
    "audit:rust": "cargo deny --config deny.toml --manifest-path src-tauri/Cargo.toml check",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "check:ci": "npm run check && npm run audit:rust && npm run audit:npm"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.26.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
